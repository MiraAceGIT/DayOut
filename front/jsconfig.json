{
  // Verification des types depuis les JSDoc : VS Code l'applique en direct, la CI lance tools/typecheck.sh.
  // Perimetre : tout src/ (routeur, pages, views comprises), null et undefined verifies (strictNullChecks).
  // Les tests ont leur propre config (tests/jsconfig.json) : leurs assertions garantissent deja les non-null.
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js"
  ]
}
