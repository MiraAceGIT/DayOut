{
  // Verification des types depuis les JSDoc : VS Code l'applique en direct, la CI lance `tsc -p front/jsconfig.json`.
  // Perimetre : couches sans DOM, controleurs (et les views qu'ils importent) ; le reste de view/ suivra.
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/model/**/*.js",
    "src/shared/**/*.js",
    "src/core/**/*.js",
    "src/controller/**/*.js",
    "tests/**/*.js"
  ]
}
