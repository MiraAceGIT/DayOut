# =============================================================================
# Front controller + hardening Apache
# =============================================================================

Options -Indexes
Options -MultiViews

RewriteEngine On
# Pas de RewriteBase : la cible index.php reste relative a ce dossier, ce qui
# fonctionne aussi dans un sous-dossier (http://localhost/dayout/back/public/).
# Le prefixe est retire du chemin par Request::fromGlobals().

# Si le fichier/dossier existe, servir directement (fichiers statiques).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Les en-tetes de securite sont envoyes par PHP (App\Core\Http\SecurityHeaders),
# seule source pour qu'ils soient identiques sous Apache et sous `php -S`.

# -----------------------------------------------------------------------------
# Fichiers sensibles / dotfiles : refuser l'acces direct.
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|md|sql|yml|yaml|lock|dist|example)$">
    Require all denied
</FilesMatch>
