# Copier ce fichier en `.env` et adapter.
# IMPORTANT : ne jamais committer `.env` (voir .gitignore).

APP_DEBUG=false
# dev | prod. prod : MAIL_DEMO interdit (refus au demarrage), mails journalises sans leur contenu (liens).
APP_ENV=dev
APP_TIMEZONE=UTC
# /docs (Swagger UI) et /openapi.json : true en dev, false en prod (defaut).
DOCS_ENABLED=true

# BDD (XAMPP par defaut : root sans mot de passe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dayout
DB_USER=root
DB_PASSWORD=

# Origines autorisees pour le front (CORS). Liste separee par des virgules.
# Vide = aucun navigateur cross-origin autorise.
# Dev local : http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=http://localhost:5500

# Journalisation (voir README, section Journalisation).
# LOG_LEVEL : debug | info | notice | warning | error | critical | alert | emergency
# LOG_PATH : relatif a back/ ou absolu.
LOG_LEVEL=info
LOG_PATH=storage/logs
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365

# Adresse du front : base des liens envoyes par mail (confirmation d'inscription).
FRONT_URL=http://localhost:5500
# Les mails sont ecrits dans LOG_PATH/mail-AAAA-MM-JJ.log (sans leur contenu si APP_ENV=prod). true : l'API
# renvoie aussi le lien de confirmation pour l'afficher a l'ecran (demo sans serveur de mail). Interdit en prod.
MAIL_DEMO=false

# Reverse proxies devant l'API (adresses ou plages CIDR, separees par des virgules), ex. 127.0.0.1,10.0.0.0/8.
# Vide = pas de proxy : X-Forwarded-For est ignore. Derriere un proxy non declare, tous les clients ont l'adresse du
# proxy et partagent donc les memes limites.
TRUSTED_PROXIES=
# Limites par client (adresse IP ; /64 en IPv6) et par heure. Un campus derriere une seule IP publique les partage.
RATE_LIMIT_REGISTRATIONS_PER_HOUR=5
RATE_LIMIT_REGISTRATION_ATTEMPTS_PER_HOUR=30
RATE_LIMIT_EMAIL_VERIFICATIONS_PER_HOUR=30
