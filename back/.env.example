# Copier ce fichier en `.env` et adapter.
# IMPORTANT : ne jamais committer `.env` (voir .gitignore).

APP_DEBUG=false
APP_TIMEZONE=UTC

# BDD (XAMPP par defaut : root sans mot de passe)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dayout
DB_USER=root
DB_PASSWORD=

# Origines autorisees pour le front (CORS). Liste separee par des virgules.
# Vide = aucun navigateur cross-origin autorise.
# Dev local : http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=http://localhost:5500
